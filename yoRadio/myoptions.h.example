#ifndef MYOPTIONS_H
#define MYOPTIONS_H

/*
 * Copy this file to myoptions.h in this directory.
 * I2C and I2S GPIOs below were supplied from the user's ESPHome configuration.
 * Encoder GPIOs still need to be set to match the actual wiring.
 */

#define L10N_LANGUAGE EN
#define DSP_MODEL DSP_SH1106

/* SH1106 I2C — pins from the user's ESPHome configuration. */
#define I2C_SDA 8
#define I2C_SCL 9

/* I2S PCM5100A — pins from the user's ESPHome configuration. */
#define I2S_DOUT 7
#define I2S_BCLK 5
#define I2S_LRC 6

/* I2S DAC is used, not VS1053. */
#define VS1053_CS 255

/* Rotary encoder — set GPIOs for A/left, button and B/right if present. */
#define ENC_BTNL 255
#define ENC_BTNB 255
#define ENC_BTNR 255
#define ENC_INTERNALPULLUP true

#endif
